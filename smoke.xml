<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Smoke" verbose="1">
    <test name="Smoke Tests" parallel="classes" thread-count="3">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.kriti.automation.tests.LoginTest"/>
            <class name="com.kriti.automation.tests.CartTest"/>
            <class name="com.kriti.automation.tests.SortTest"/>
            <class name="com.kriti.automation.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
